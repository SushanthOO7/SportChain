{
  "name": "sportchain",
  "version": "0.1.0",
  "description": "SportChain: blockchain-based provenance tracking for athletic footwear (CSE 540 course project)",
  "type": "module",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "typecheck": "tsc --noEmit",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat ignition deploy ignition/modules/SportChain.ts --network localhost",
    "demo": "hardhat run scripts/demo-journey.ts --network localhost",
    "seed": "hardhat run scripts/seed.ts --build-profile production --network localhost",
    "frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@nomicfoundation/ignition-core": "^3.1.11",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "chai": "^6.3.0",
    "ethers": "^6.17.0",
    "hardhat": "^3.21.2",
    "mocha": "^12.0.3",
    "typescript": "~5.9"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
