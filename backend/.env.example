# SQLite works immediately for a native local demo. PostgreSQL is recommended.
DATABASE_URL=postgresql+psycopg://sportchain:sportchain@127.0.0.1:5432/sportchain
RPC_URL=http://127.0.0.1:8545
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_DOMAIN=sportchain.local
# DEPLOYMENT_FILE defaults to ../.runtime/deployment.json relative to backend.
# STORAGE_DIR defaults to backend/data/files.
